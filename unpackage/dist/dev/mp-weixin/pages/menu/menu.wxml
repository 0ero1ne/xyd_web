<view class="page data-v-388b40d3"><view class="workbench data-v-388b40d3"><view class="workbench-top data-v-388b40d3"><view class="data-v-388b40d3"><text class="eyebrow data-v-388b40d3">飞手服务台</text><text class="headline data-v-388b40d3">发现附近待接任务</text></view><text class="status-pill data-v-388b40d3">{{a}}</text></view><text class="caption data-v-388b40d3">确认作物、面积、距离和报价，快速承接适合您的植保作业。</text><button class="action-button data-v-388b40d3" bindtap="{{c}}">{{b}}</button></view><view class="quick-grid data-v-388b40d3"><view wx:for="{{d}}" wx:for-item="item" wx:key="c" class="quick-item data-v-388b40d3"><text class="quick-value data-v-388b40d3">{{item.a}}</text><text class="quick-label data-v-388b40d3">{{item.b}}</text></view></view><view class="section-heading data-v-388b40d3"><text class="section-title data-v-388b40d3">推荐任务</text><text class="more data-v-388b40d3" bindtap="{{e}}">刷新</text></view><view wx:if="{{f}}" class="state-card data-v-388b40d3">任务加载中...</view><view wx:elif="{{g}}" class="state-card data-v-388b40d3">暂无推荐任务</view><view wx:else class="data-v-388b40d3"><view wx:for="{{h}}" wx:for-item="item" wx:key="g" class="task-card data-v-388b40d3" bindtap="{{item.h}}"><view class="task-main data-v-388b40d3"><text class="task-title data-v-388b40d3">{{item.a}}</text><text class="task-detail data-v-388b40d3">{{item.b}}</text><view wx:if="{{item.c}}" class="tags data-v-388b40d3"><text wx:for="{{item.d}}" wx:for-item="tag" wx:key="b" class="tag data-v-388b40d3">{{tag.a}}</text></view></view><view class="task-side data-v-388b40d3"><text class="price data-v-388b40d3">{{item.e}}</text><button class="accept-button data-v-388b40d3" catchtap="{{item.f}}">接单</button></view></view></view></view>