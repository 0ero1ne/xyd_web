<view class="page data-v-9db9159f"><view wx:for="{{a}}" wx:for-item="item" wx:key="k" class="address data-v-9db9159f"><view class="title data-v-9db9159f"><text class="data-v-9db9159f">{{item.a}}</text><text wx:if="{{item.b}}" class="tag data-v-9db9159f">默认</text></view><text class="line data-v-9db9159f">{{item.c}}{{item.d}}</text><text class="line data-v-9db9159f">{{item.e}} {{item.f}}</text><view class="actions data-v-9db9159f"><text wx:if="{{item.g}}" class="data-v-9db9159f" bindtap="{{item.h}}">设为默认</text><text class="data-v-9db9159f" bindtap="{{item.i}}">编辑</text><text class="delete data-v-9db9159f" bindtap="{{item.j}}">删除</text></view></view><view wx:if="{{b}}" class="empty data-v-9db9159f">暂无服务地址，请添加常用作业地点。</view><view wx:if="{{c}}" class="editor data-v-9db9159f"><text class="editor-title data-v-9db9159f">{{d}}</text><input class="data-v-9db9159f" placeholder="地址名称，如：东侧水稻田" value="{{e}}" bindinput="{{f}}"/><picker class="data-v-9db9159f" mode="region" value="{{h}}" bindchange="{{i}}"><view class="picker data-v-9db9159f">{{g}}</view></picker><input class="data-v-9db9159f" placeholder="详细地点或地块描述" value="{{j}}" bindinput="{{k}}"/><input class="data-v-9db9159f" placeholder="联系人" value="{{l}}" bindinput="{{m}}"/><input class="data-v-9db9159f" type="number" maxlength="11" placeholder="联系电话" value="{{n}}" bindinput="{{o}}"/><view class="switch data-v-9db9159f"><text class="data-v-9db9159f">设为默认地址</text><switch class="data-v-9db9159f" checked="{{p}}" color="#237a4d" bindchange="{{q}}"/></view><view class="buttons data-v-9db9159f"><button class="cancel data-v-9db9159f" bindtap="{{r}}">取消</button><button class="save data-v-9db9159f" bindtap="{{s}}">保存</button></view></view><button wx:if="{{t}}" class="add data-v-9db9159f" bindtap="{{v}}">新增服务地址</button></view>