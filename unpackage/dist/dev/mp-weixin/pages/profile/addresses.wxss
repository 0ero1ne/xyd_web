.editor input.data-v-9db9159f, .picker.data-v-9db9159f { box-sizing: border-box; height: 84rpx; margin-top: 16rpx; padding: 0 20rpx; border-radius: 13rpx; color: #111827; font-size: 27rpx; background: #f5f8f4;
